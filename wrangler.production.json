{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "raindance-ai",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true },
  "routes": [{ "pattern": "raindance-ai.net", "custom_domain": true }],
  "vars": {
    "DATABASE_PROVIDER": "d1",
    "VITE_APP_URL": "https://raindance-ai.net",
    "VITE_APP_NAME": "Raindance AI",
    "VITE_APP_DESCRIPTION": "Turn one photo into a cinematic golden-hour seaside video.",
    "VITE_APP_LOGO": "/logo.svg",
    "VITE_DEFAULT_LOCALE": "en",
    "MEDIA_PUBLIC_URL": "https://media.raindance-ai.net"
  },
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "raindance-ai-media" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "raindance-ai-db",
      "database_id": "00c5a3b8-4a49-4304-8d6a-86f976a9ec80",
      "migrations_dir": "drizzle"
    }
  ]
}
